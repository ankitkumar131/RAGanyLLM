  "version": "1.0.0",
  "description": "Universal local RAG Studio CLI for any Ollama LLM with interactive setup, external SSD support, and real-time streaming progress",
  "main": "lib/server.js",
  "bin": {
    "raganyllm": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "public"
  ],
  "preferGlobal": true,
  "scripts": {
