    "vector-search",
    "cli",
    "embeddings",
    "external-ssd"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "express": "^4.19.2",
    "inquirer": "^8.2.6",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "open": "^8.4.2",
    "pdf-parse": "^1.1.1"
  }
